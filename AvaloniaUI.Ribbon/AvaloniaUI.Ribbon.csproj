<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>AvaloniaUI.Ribbon</RootNamespace>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<Version>0.9.10</Version>
		<Authors>Splitwirez, Alban Mazerolles, Rubal Walia, Sachith Liyanagama, Vadim Belov</Authors>
		<PackageId>AvaloniaControls.Ribbon</PackageId>
		<PackageProjectUrl>https://github.com/Vadimgold/Avalonia.Ribbon</PackageProjectUrl>
		<Description>Office-Like ribbon control for Avalonia framework, migrated to Avalonia 12.</Description>
		<RepositoryType>Git</RepositoryType>
		<RepositoryUrl>https://github.com/Vadimgold/Avalonia.Ribbon.git</RepositoryUrl>
		<AssemblyName>AvaloniaUI.Ribbon</AssemblyName>
		<LangVersion>latest</LangVersion>
		<PackageTags>ribbon;avalonia;avaloniaui;avalonia ui;ribbon;ribbonui;ribbon ui;crossplat;crossplatform;cross platform;xplat;xplatform;wasm</PackageTags>
		<Title>Cross-Platform Ribbon control for Avalonia</Title>
		<Copyright>Original Copyright (c) 2023 Sachith Liyanagama. Modifications Copyright (c) 2026 Vadim Belov</Copyright>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	<ItemGroup>
		<Compile Update="**\*.axaml.cs">
			<DependentUpon>%(Filename)</DependentUpon>
		</Compile>
		<AvaloniaResource Include="**\*.axaml">
			<SubType>Designer</SubType>
		</AvaloniaResource>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>
	<ItemGroup>
		<AvaloniaXaml Remove="Styles\Fluent\Controls\RibbonDropDownItemsPresenter.axaml" />
	</ItemGroup>
	<ItemGroup>
		<None Include="LICENSE" Pack="True" PackagePath="\" />
		<None Include="README.md" Pack="True" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.0.3" />
		<PackageReference Include="ReactiveUI.Avalonia" Version="12.0.1" />
		<PackageReference Include="Xaml.Behaviors.Interactions" Version="12.0.0" />
	</ItemGroup>
</Project>
