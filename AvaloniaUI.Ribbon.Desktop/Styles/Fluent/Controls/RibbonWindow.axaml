<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:AvaloniaUI.Ribbon.Desktop.Converters;assembly=AvaloniaUI.Ribbon.Desktop"
    xmlns:windows="clr-namespace:AvaloniaUI.Ribbon.Desktop;assembly=AvaloniaUI.Ribbon.Desktop">
    <Styles.Resources>
        <converters:WindowIconToImageConverter x:Key="WindowIconToImageConverter" />
    </Styles.Resources>

    <Style Selector="windows|RibbonWindow">
        <Setter Property="TitleBarBackground">
            <SolidColorBrush Opacity="0.75" Color="{DynamicResource SystemAccentColor}" />
        </Setter>
        <Setter Property="TitleBarForeground" Value="{DynamicResource SystemControlHighlightAltBaseHighBrush}" />
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
        <Setter Property="TransparencyLevelHint" Value="AcrylicBlur" />
        <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="windows:RibbonWindow">
                    <Panel>
                        <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
                        <Border Background="{TemplateBinding Background}" IsHitTestVisible="False" />
                        <Panel Margin="{TemplateBinding WindowDecorationMargin}" Background="Transparent" />
                        <VisualLayerManager>
                            <DockPanel>
                                <!--
                                    PART_TitleBar перекрывает системный заголовок окна.
                                    Системные кнопки (min/max/close) остаются нативными — поверх нашего контента.
                                    WindowDecorationMargin автоматически даёт отступ под кнопки.
                                -->
                                <Grid x:Name="PART_TitleBar"
                                      DockPanel.Dock="Top"
                                      Height="{TemplateBinding ExtendClientAreaTitleBarHeightHint}"
                                      Background="{TemplateBinding TitleBarBackground}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Window icon -->
                                    <Image Grid.Column="0"
                                           MaxWidth="16" MaxHeight="16"
                                           Margin="9,0,4,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"
                                           Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=windows:RibbonWindow}, Converter={StaticResource WindowIconToImageConverter}}" />

                                    <!-- QuickAccessToolbar — слева, не перекрывает системные кнопки -->
                                    <ContentPresenter Grid.Column="1"
                                                      x:Name="PART_QuickAccessToolbarPresenter"
                                                      Margin="0,0,140,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Stretch"
                                                      Content="{TemplateBinding QuickAccessToolbar}" />
                                </Grid>

                                <DockPanel LastChildFill="True">
                                    <ContentPresenter x:Name="PART_RibbonPresenter"
                                                      VerticalAlignment="Top"
                                                      DockPanel.Dock="Top"
                                                      Content="{TemplateBinding Ribbon}">
                                        <Interaction.Behaviors>
                                            <DataTriggerBehavior
                                                Binding="{Binding Ribbon.Orientation, RelativeSource={RelativeSource TemplatedParent}}"
                                                ComparisonCondition="Equal"
                                                Value="{x:Static Orientation.Horizontal}">
                                                <ChangePropertyAction TargetObject="{Binding #PART_RibbonPresenter}"
                                                                      PropertyName="DockPanel.Dock"
                                                                      Value="{x:Static Dock.Top}" />
                                                <ChangePropertyAction TargetObject="{Binding #PART_RibbonPresenter}"
                                                                      PropertyName="VerticalAlignment"
                                                                      Value="{x:Static VerticalAlignment.Top}" />
                                            </DataTriggerBehavior>
                                            <DataTriggerBehavior
                                                Binding="{Binding Ribbon.Orientation, RelativeSource={RelativeSource TemplatedParent}}"
                                                ComparisonCondition="Equal"
                                                Value="{x:Static Orientation.Vertical}">
                                                <ChangePropertyAction TargetObject="{Binding #PART_RibbonPresenter}"
                                                                      PropertyName="DockPanel.Dock"
                                                                      Value="{x:Static Dock.Left}" />
                                                <ChangePropertyAction TargetObject="{Binding #PART_RibbonPresenter}"
                                                                      PropertyName="VerticalAlignment"
                                                                      Value="{x:Static VerticalAlignment.Stretch}" />
                                            </DataTriggerBehavior>
                                        </Interaction.Behaviors>
                                    </ContentPresenter>
                                    <ContentPresenter Name="PART_ContentPresenter"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </DockPanel>
                            </DockPanel>
                        </VisualLayerManager>
                    </Panel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="windows|RibbonWindow[IsActive=false]">
        <Setter Property="TitleBarBackground" Value="{DynamicResource ThemeControlMidHighBrush}" />
    </Style>
</Styles>
