<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AvaloniaUI.Ribbon.Desktop;assembly=AvaloniaUI.Ribbon.Desktop"
    xmlns:windows="clr-namespace:AvaloniaUI.Ribbon.Desktop;assembly=AvaloniaUI.Ribbon.Desktop"
    xmlns:ribbon="clr-namespace:AvaloniaUI.Ribbon;assembly=AvaloniaUI.Ribbon">
	<Style Selector="local|QuickAccessToolbar">
		<Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAltBaseHighBrush}" />
		<Setter Property="Height" Value="30" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Margin" Value="0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="local:QuickAccessToolbar">
					<DockPanel>
						<ToggleButton
                            x:Name="PART_MoreButton"
                            VerticalAlignment="Stretch"
                            DockPanel.Dock="Right">
							<ToggleButton.ContextMenu>
								<ContextMenu Placement="Bottom">
									<ContextMenu.Template>
										<ControlTemplate>
											<Border
                                                MinHeight="{TemplateBinding MinHeight}"
                                                MaxWidth="{TemplateBinding MaxWidth}"
                                                Padding="{TemplateBinding Padding}"
                                                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{DynamicResource OverlayCornerRadius}">
												<DockPanel>
													<Border
                                                        Height="30"
                                                        Padding="15,0"
                                                        DockPanel.Dock="Top">
														<TextBlock
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            FontWeight="DemiBold"
                                                            Text="{DynamicResource AvaloniaRibbon.CustomizeQAT}" />
													</Border>
													<ScrollViewer Classes="menuscroller">
														<ItemsPresenter
                                                            Name="PART_ItemsPresenter"
                                                            Margin="{DynamicResource MenuFlyoutScrollerMargin}"
                                                            Grid.IsSharedSizeScope="True"
                                                            ItemsPanel="{TemplateBinding ItemsPanel}"
                                                            KeyboardNavigation.TabNavigation="Continue" />
													</ScrollViewer>
												</DockPanel>
											</Border>
										</ControlTemplate>
									</ContextMenu.Template>
									<ContextMenu.Styles>
										<Style Selector="MenuItem:not(.quickAccessFixedItem)">
											<Setter Property="Command"
                                                    Value="{Binding $parent[local:QuickAccessToolbar].MoreFlyoutMenuItemCommand}" />
											<Setter Property="CommandParameter" Value="{ReflectionBinding Item}" />
											<Setter Property="ribbon:QuickAccessProperties.IsChecked"
                                                    Value="{ReflectionBinding IsChecked}" />
										</Style>
										<Style Selector="MenuItem">
											<Setter Property="Template"
                                                    Value="{DynamicResource CheckableMenuItemControlTemplate}" />
										</Style>
									</ContextMenu.Styles>
									<ContextMenu.DataTemplates>
										<DataTemplate>
											<TextBlock Text="{ReflectionBinding Item.Content}" />
										</DataTemplate>
									</ContextMenu.DataTemplates>
								</ContextMenu>
							</ToggleButton.ContextMenu>
							<StackPanel
                                Width="7"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Vertical"
                                Spacing="2">
								<Rectangle
                                    Height="1"
                                    HorizontalAlignment="Stretch"
                                    Fill="{Binding $parent[ToggleButton].Foreground}" />
								<Path
                                    Width="7"
                                    Height="3"
                                    HorizontalAlignment="Center"
                                    ClipToBounds="True"
                                    Data="M 0.5 0 L 3.5 3 L 6.5 0"
                                    Stroke="{Binding $parent[ToggleButton].Foreground}"
                                    StrokeThickness="1" />
							</StackPanel>
						</ToggleButton>
						<ItemsControl VerticalAlignment="Stretch" ItemsSource="{TemplateBinding ItemsSource}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
						</ItemsControl>
					</DockPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style Selector="local|QuickAccessToolbar /template/ ToggleButton#PART_MoreButton:not(:pointerover):not(:pressed)">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
	</Style>
	<Style Selector="windows|RibbonWindow local|QuickAccessToolbar /template/ ToggleButton#PART_MoreButton:not(:pointerover):not(:pressed):not(:checked)">
		<Setter Property="Foreground" Value="{Binding $parent[windows:RibbonWindow].TitleBarForeground}" />
	</Style>
	<Style Selector="windows|RibbonWindow[IsActive=False] local|QuickAccessToolbar /template/ ToggleButton#PART_MoreButton:not(:pointerover):not(:pressed):not(:checked) > StackPanel">
		<Setter Property="Opacity" Value="0.5" />
	</Style>

	<Style Selector="local|QuickAccessItem">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="local:QuickAccessItem">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TemplatedControl
                            Grid.Column="0"
                            DataContext="{TemplateBinding Item}"
                            Foreground="{Binding $parent[windows:RibbonWindow].TitleBarForeground}"
                            Template="{Binding Item.QuickAccessTemplate, RelativeSource={RelativeSource Mode=TemplatedParent}}">
							<TemplatedControl.ContextMenu>
								<ContextMenu>
									<MenuItem x:Name="PART_RemoveFromQuickAccessToolbar"
                                              Header="Remove from quick access toolbar" />
								</ContextMenu>
							</TemplatedControl.ContextMenu>
						</TemplatedControl>
						<Border
                            Grid.Column="1"
                            Width="1"
                            Height="20"
                            Margin="2"
                            Padding="0"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{Binding $parent[windows:RibbonWindow].TitleBarForeground}"
                            BorderThickness="1"
                            Opacity="0.5" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</Styles>
